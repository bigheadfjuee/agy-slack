# ==============================================================================
# Slack Credentials (Required for Socket Mode)
# ==============================================================================
# Bot User OAuth Token (OAuth & Permissions -> Bot User OAuth Token, starts with xoxb-)
SLACK_BOT_TOKEN=xoxb-your-bot-token

# App-Level Token (Basic Information -> App-Level Tokens with connections:write, starts with xapp-)
SLACK_APP_TOKEN=xapp-your-app-level-token

# Optional HTTP/HTTPS Proxy URL for Slack Web API & Socket Mode WebSocket.
# Leave empty to automatically inherit HTTPS_PROXY / HTTP_PROXY from your environment.
# Set to "none" to explicitly bypass environment proxy variables.
SLACK_PROXY_URL=

# ==============================================================================
# Access Control (Optional, comma-separated IDs. Leave empty to allow everyone)
# ==============================================================================
# Example: U01234567,U09876543
SLACK_ALLOWED_USERS=
# Example: C01234567,D09876543
SLACK_ALLOWED_CHANNELS=

# ==============================================================================
# Antigravity CLI (agy) Configuration
# ==============================================================================
# Path or command name for Antigravity CLI
AGY_BIN=agy

# Working directory where agy runs (defaults to current working directory if empty)
AGY_WORKDIR=

# Optional default model (leave empty to use agy's default model)
AGY_MODEL=

# Execution mode: auto | accept-edits | plan (leave empty to use agy default)
AGY_MODE=

# Reasoning effort: low | medium | high | xhigh | max (optional)
AGY_EFFORT=

# Run agy inside terminal sandbox (true | false)
AGY_SANDBOX=false

# Auto-approve all tool permission requests in non-interactive mode (true | false)
# WARNING: Only enable if you trust the Slack users/channels allowed to use this bot!
AGY_DANGEROUSLY_SKIP_PERMISSIONS=false

# Timeout per prompt in seconds (0 = wait until completion)
AGY_TIMEOUT_SECONDS=300

# ==============================================================================
# Bridge Settings
# ==============================================================================
# Path to store thread <-> conversation mappings
SESSION_STORE_PATH=./data/sessions.json

# Streaming update throttle interval in milliseconds
STREAM_UPDATE_INTERVAL_MS=1000

# Log level: debug | info | warn | error
LOG_LEVEL=info
