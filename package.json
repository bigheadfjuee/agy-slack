{
  "name": "agy-slack",
  "version": "1.0.0",
  "description": "Slack Bot bridge for Google Antigravity CLI (agy) via Socket Mode with thread-to-conversation continuity and live streaming",
  "type": "module",
  "main": "dist/index.js",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "start": "tsx src/index.ts",
    "build": "tsc",
    "start:prod": "node dist/index.js",
    "typecheck": "tsc --noEmit",
    "test": "node --import tsx --test tests/*.test.ts"
  },
  "dependencies": {
    "@slack/bolt": "^4.4.0",
    "dotenv": "^16.4.7",
    "https-proxy-agent": "^9.1.0"
  },
  "devDependencies": {
    "@types/node": "^22.13.0",
    "tsx": "^4.19.2",
    "typescript": "^5.7.3"
  },
  "engines": {
    "node": ">=20.0.0"
  },
  "packageManager": "pnpm@11.5.1"
}
